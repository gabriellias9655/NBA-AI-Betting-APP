{
  "name": "world-cup-2026-desktop",
  "version": "1.0.0",
  "description": "FIFA World Cup 2026 prediction desktop app with ML-style match models",
  "main": "electron/main.mjs",
  "author": "YCSLINT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/ensure-electron.mjs && node scripts/setup-python.mjs",
    "setup:engine": "node scripts/copy-nba-engine.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:python:full": "node scripts/setup-python.mjs --full",
    "icons": "node scripts/generate-app-icon.mjs",
    "prefetch:stats": "node scripts/prefetch-stats.mjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "prebuild": "npm run icons",
    "prebuild:win:signed": "npm run icons",
    "prebuild:portable": "npm run icons",
    "prebuild:portable:signed": "npm run icons",
    "start": "electron .",
    "build": "cross-env SIGN_WINDOWS=false electron-builder --config electron-builder.config.cjs",
    "build:win": "cross-env SIGN_WINDOWS=false electron-builder --config electron-builder.config.cjs --win --x64",
    "build:win:signed": "node scripts/ensure-win-certificate.mjs && cross-env SIGN_WINDOWS=true electron-builder --config electron-builder.config.cjs --win",
    "build:portable": "cross-env SIGN_WINDOWS=false electron-builder --config electron-builder.portable.json",
    "build:portable:signed": "node scripts/ensure-win-certificate.mjs && cross-env SIGN_WINDOWS=true electron-builder --config electron-builder.portable.config.cjs",
    "build:mac": "node scripts/prepare-mac-install.mjs && electron-builder --config electron-builder.config.cjs --mac && node scripts/prepare-mac-release.mjs",
    "build:mac:signed": "cross-env SIGN_MAC=true node scripts/prepare-mac-install.mjs && cross-env SIGN_MAC=true electron-builder --config electron-builder.config.cjs --mac",
    "postinstall": "node scripts/ensure-electron.mjs && node scripts/patch-chalk-upload-skip.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "chalk-ycslint": "^1.0.11",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "rcedit": "^4.0.1",
    "sharp": "^0.35.1"
  },
  "build": {
    "forceCodeSigning": false,
    "appId": "com.ycslint.worldcup2026",
    "productName": "World Cup 2026 Lab",
    "icon": "build/icon.png",
    "compression": "maximum",
    "electronLanguages": ["en-US"],
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json",
      "nba-engine/Flask/**/*",
      "nba-engine/Data/wc_teams_bootstrap.json",
      "nba-engine/requirements-wc.txt",
      "!scripts/**/*",
      "!nba-engine/.venv/**/*",
      "!nba-engine/Data/*.sqlite",
      "!nba-engine/Data/nba-*/**",
      "!nba-engine/Data/team_stats*.json",
      "!nba-engine/Models/**",
      "!nba-engine/src/**",
      "!nba-engine/Tests/**",
      "!nba-engine/scripts/**",
      "!**/node_modules/pdf-parse/test/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v1.9.426/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v1.10.88/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/v2.0.550/**",
      "!**/node_modules/pdf-parse/lib/pdf.js/**/web/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/{test,tests,__tests__,docs,doc,example,examples,coverage,.github}/**",
      "!**/node_modules/**/*.{md,markdown,ts,flow}"
    ],
    "asarUnpack": [
      "nba-engine/Flask/**/*",
      "nba-engine/Data/wc_teams_bootstrap.json",
      "nba-engine/requirements-wc.txt"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "WorldCup2026Lab",
      "signAndEditExecutable": false,
      "target": "nsis",
      "signDlls": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "shortcutName": "World Cup 2026 Lab",
      "uninstallDisplayName": "World Cup 2026 Lab",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.sports",
      "target": ["dmg"],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "World Cup 2026 Lab"
    }
  }
}
